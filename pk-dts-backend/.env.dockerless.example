# Dockerless local development
# Requires a native/local PostgreSQL server or any reachable PostgreSQL instance.
APP_ENV=dockerless
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
UPLOAD_BASE_URL=http://localhost:3000

DATABASE_PROVIDER=postgresql
PRISMA_SCHEMA_PATH=prisma/schema.postgresql.prisma
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/document_tracking?schema=public

# Redis is intentionally optional in dockerless mode.
CACHE_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_MS=15000
CACHE_MAX_ITEMS=500

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
